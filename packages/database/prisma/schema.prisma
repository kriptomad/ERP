// Filitech ERP V2 — BIBLE_ENGINEERING_V2 Cap. 5+
// 3 produtos: BUSINESS | PERSONAL | ACCOUNTING_OFFICE

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus { TRIAL ACTIVE PAST_DUE SUSPENDED CANCELLED }
enum TenantType { BUSINESS PERSONAL ACCOUNTING_OFFICE }
enum TaxRegime { MEI SIMPLES_NACIONAL LUCRO_PRESUMIDO LUCRO_REAL }
enum PlanAudience { BUSINESS PERSONAL BOTH }
enum SubscriptionStatus { TRIAL ACTIVE PAST_DUE SUSPENDED CANCELLED }
enum ReferralStatus { PENDING CONVERTED EXPIRED }
enum UserRole { OWNER MANAGER TECHNICIAN CASHIER ACCOUNTANT HOUSEHOLD_MEMBER }
enum ProductTrackingType { NONE BATCH SERIAL VARIANT }
enum WorkOrderStatus { RECEIVED DIAGNOSING AWAITING_APPROVAL IN_REPAIR READY DELIVERED CANCELLED }
enum CashRegisterStatus { OPEN CLOSED }
enum StockMovementType { IN OUT ADJUSTMENT RETURN PRODUCTION }
enum LoyaltyTransactionType { EARN REDEEM EXPIRE MANUAL_ADJUST }
enum PersonalAccountType { CHECKING SAVINGS CREDIT_CARD WALLET }
enum PersonalTransactionType { INCOME EXPENSE TRANSFER }
enum AccountingEngagementStatus {
  PENDING_ACCOUNTANT_ACCEPTANCE
  ACTIVE
  EXPIRED
  REVOKED_BY_CLIENT
  REVOKED_BY_ACCOUNTANT
}

model Tenant {
  id                           String       @id @default(uuid())
  parentTenantId               String?
  slug                         String       @unique
  legalName                    String
  tradeName                    String
  cnpj                         String?      @unique
  tenantType                   TenantType   @default(BUSINESS)
  status                       TenantStatus @default(TRIAL)
  gracePeriodEndsAt            DateTime?
  taxRegime                    TaxRegime    @default(SIMPLES_NACIONAL)
  simplesNacionalAnexo         String?
  inscricaoEstadual            String?
  uf                           String?
  termsAcceptedAt              DateTime?
  termsVersionAccepted         String?
  privacyPolicyAcceptedAt      DateTime?
  privacyPolicyVersionAccepted String?
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  parentTenant          Tenant?                @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  childTenants          Tenant[]               @relation("TenantHierarchy")
  subscriptions         Subscription[]
  tenantModules         TenantModule[]
  users                 User[]
  referralCode          ReferralCode?
  referredAs            Referral?              @relation("ReferredTenant")
  clients               Client[]
  suppliers             Supplier[]
  products              Product[]
  productBatches        ProductBatch[]
  sales                 Sale[]
  cashRegisters         CashRegister[]
  workOrders            WorkOrder[]
  stockMovements        StockMovement[]
  recipes               Recipe[]
  productionBatches     ProductionBatch[]
  containerLedgers      ReturnableContainerLedger[]
  prescriptions         PrescriptionRecord[]
  loyaltyProgram        LoyaltyProgram?
  loyaltyAccounts       LoyaltyAccount[]
  personalAccounts      PersonalAccount[]
  personalCategories    PersonalCategory[]
  personalTransactions  PersonalTransaction[]
  personalDebts         PersonalDebt[]
  personalBudgets       PersonalBudget[]
  personalBills         PersonalBill[]
  openFinanceConsents   OpenFinanceConsent[]
  netWorthSnapshots     NetWorthSnapshot[]
  accountingFirmProfile AccountingFirmProfile?
  engagementsAsFirm     AccountingEngagement[] @relation("EngagementsAsFirm")
  engagementsAsClient   AccountingEngagement[] @relation("EngagementsAsClient")
  accountingTasks       AccountingTask[]

  @@index([status])
  @@index([parentTenantId])
  @@index([tenantType])
  @@map("tenants")
}

model Plan {
  id                   String       @id @default(uuid())
  code                 String       @unique
  label                String
  basePrice            Decimal      @db.Decimal(10, 2)
  includedModules      String[]
  active               Boolean      @default(true)
  audience             PlanAudience @default(BUSINESS)
  maxConnectedAccounts Int?
  subscriptions        Subscription[]
  @@map("plans")
}

model Module {
  id            String         @id @default(uuid())
  code          String         @unique
  label         String
  monthlyPrice  Decimal        @db.Decimal(10, 2)
  description   String
  active        Boolean        @default(true)
  tenantModules TenantModule[]
  @@map("modules")
}

model TenantModule {
  id            String    @id @default(uuid())
  tenantId      String
  moduleCode    String
  active        Boolean   @default(true)
  activatedAt   DateTime  @default(now())
  deactivatedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleCode], references: [code])
  @@unique([tenantId, moduleCode])
  @@index([tenantId, active])
  @@map("tenant_modules")
}

model Subscription {
  id                        String             @id @default(uuid())
  tenantId                  String
  planId                    String
  provider                  String
  externalSubscriptionId    String             @unique
  status                    SubscriptionStatus @default(TRIAL)
  pastDueSince              DateTime?
  currentPeriodEnd          DateTime?
  paymentMethodToken        String?
  paymentMethodBrand        String?
  paymentMethodLast4        String?
  failedPaymentAttempts     Int                @default(0)
  nextRetryAt               DateTime?
  firstChargedAt            DateTime?
  cancelRequestedAt         DateTime?
  cancelAtPeriodEnd         Boolean            @default(false)
  creditBalanceMonths       Int                @default(0)
  firstCycleDiscountPercent Int?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan           @relation(fields: [planId], references: [id])
  billingEvents BillingEvent[]
  @@index([tenantId, status])
  @@map("subscriptions")
}

model BillingEvent {
  id               String   @id @default(uuid())
  subscriptionId   String
  provider         String
  externalEventKey String
  type             String
  payload          Json
  createdAt        DateTime @default(now())
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([provider, externalEventKey])
  @@index([subscriptionId, createdAt])
  @@map("billing_events")
}

model ReferralCode {
  id        String     @id @default(uuid())
  tenantId  String     @unique
  code      String     @unique
  createdAt DateTime   @default(now())
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  referrals Referral[]
  @@map("referral_codes")
}

model Referral {
  id               String         @id @default(uuid())
  referralCodeId   String
  referredTenantId String         @unique
  status           ReferralStatus @default(PENDING)
  rewardAppliedAt  DateTime?
  expiresAt        DateTime
  createdAt        DateTime       @default(now())
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referredTenant Tenant       @relation("ReferredTenant", fields: [referredTenantId], references: [id], onDelete: Cascade)
  @@index([status, expiresAt])
  @@map("referrals")
}

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  name                String
  email               String
  passwordHash        String
  role                UserRole
  active              Boolean   @default(true)
  preferredThemeMode  String    @default("light")
  totpSecretEncrypted String?
  totpConfirmedAt     DateTime?
  managerPinHash      String?
  invitePending       Boolean   @default(false)
  inviteToken         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  cashRegisters   CashRegister[]
  workOrders      WorkOrder[]           @relation("AssignedTechnician")
  sales           Sale[]
  backupCodes     TwoFactorBackupCode[]
  activeSessions  ActiveSession[]
  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

model RoleDefaultPermission {
  id             String   @id @default(uuid())
  role           UserRole
  permissionCode String
  @@unique([role, permissionCode])
  @@map("role_default_permissions")
}

model RolePermission {
  id         String  @id @default(uuid())
  tenantId   String
  userId     String
  permission String
  granted    Boolean @default(true)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, permission])
  @@index([tenantId, userId])
  @@map("role_permissions")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("two_factor_backup_codes")
}

model ActiveSession {
  id        String    @id @default(uuid())
  userId    String
  tokenJti  String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("active_sessions")
}

model PlatformAdminUser {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String
  passwordHash        String
  totpSecretEncrypted String?
  totpConfirmedAt     DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  auditLogs AuditLog[]
  @@map("platform_admin_users")
}

model AuditLog {
  id                  String   @id @default(uuid())
  platformAdminUserId String?
  tenantId            String?
  action              String
  entityType          String?
  entityId            String?
  metadata            Json?
  ipAddress           String?
  createdAt           DateTime @default(now())
  platformAdmin PlatformAdminUser? @relation(fields: [platformAdminUserId], references: [id])
  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model SystemParameter {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  @@map("system_parameters")
}

model Client {
  id                String    @id @default(uuid())
  tenantId          String
  name              String
  document          String?
  phone             String?
  email             String?
  creditLimit       Decimal   @default(0) @db.Decimal(12, 2)
  creditBalanceUsed Decimal   @default(0) @db.Decimal(12, 2)
  whatsappOptInAt   DateTime?
  whatsappOptOutAt  DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales            Sale[]
  workOrders       WorkOrder[]
  loyaltyAccount   LoyaltyAccount?
  containerLedgers ReturnableContainerLedger[]
  prescriptions    PrescriptionRecord[]
  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("clients")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]
  @@unique([tenantId, document])
  @@map("suppliers")
}

model Product {
  id                            String              @id @default(uuid())
  tenantId                      String
  supplierId                    String?
  sku                           String
  barcode                       String?
  name                          String
  description                   String?
  category                      String?
  trackingType                  ProductTrackingType @default(NONE)
  ncm                           String?             @default("00000000")
  unitPrice                     Decimal             @db.Decimal(12, 2)
  wholesalePrice                Decimal?            @db.Decimal(12, 2)
  resalePrice                   Decimal?            @db.Decimal(12, 2)
  wholesaleMinQty               Int?
  stockQuantity                 Decimal             @default(0) @db.Decimal(12, 3)
  minStockThreshold             Decimal?            @db.Decimal(12, 3)
  costPrice                     Decimal?            @db.Decimal(12, 4)
  isWeighted                    Boolean             @default(false)
  isReturnableContainer         Boolean             @default(false)
  isReturnable                  Boolean             @default(true)
  requiresPrescriptionRetention Boolean             @default(false)
  isControlledSubstance         Boolean             @default(false)
  active                        Boolean             @default(true)
  createdAt                     DateTime            @default(now())
  updatedAt                     DateTime            @updatedAt
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier         Supplier?                    @relation(fields: [supplierId], references: [id])
  saleItems        SaleItem[]
  stockMovements   StockMovement[]
  batches          ProductBatch[]
  recipeItems      RecipeItem[]
  containerLedgers ReturnableContainerLedger[]
  prescriptions    PrescriptionRecord[]
  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, category])
  @@index([tenantId, active])
  @@map("products")
}

model ProductBatch {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  batchCode String
  quantity  Decimal  @db.Decimal(12, 3)
  expiresAt DateTime
  blocked   Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([tenantId, productId, batchCode])
  @@index([productId, expiresAt])
  @@map("product_batches")
}

model Recipe {
  id            String       @id @default(uuid())
  tenantId      String
  name          String
  yieldQuantity Decimal      @db.Decimal(12, 3)
  active        Boolean      @default(true)
  createdAt     DateTime     @default(now())
  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  RecipeItem[]
  @@index([tenantId])
  @@map("recipes")
}

model RecipeItem {
  id        String  @id @default(uuid())
  recipeId  String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@map("recipe_items")
}

model ProductionBatch {
  id               String   @id @default(uuid())
  tenantId         String
  recipeId         String
  quantityProduced Decimal  @db.Decimal(12, 3)
  lossQuantity     Decimal  @default(0) @db.Decimal(12, 3)
  unitCost         Decimal  @db.Decimal(12, 4)
  producedAt       DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, producedAt])
  @@map("production_batches")
}

model ReturnableContainerLedger {
  id               String   @id @default(uuid())
  tenantId         String
  clientId         String
  productId        String
  quantityHeld     Decimal  @db.Decimal(12, 3)
  depositUnitValue Decimal  @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@unique([tenantId, clientId, productId])
  @@map("returnable_container_ledgers")
}

model PrescriptionRecord {
  id                 String   @id @default(uuid())
  tenantId           String
  clientId           String
  productId          String
  prescriptionNumber String
  prescribedAt       DateTime
  retainedAt         DateTime @default(now())
  listCode           String?
  sngpcStatus        String   @default("PENDING_TRANSMISSION")
  saleId             String?
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  @@index([tenantId, clientId])
  @@map("prescription_records")
}

model Sale {
  id             String   @id @default(uuid())
  tenantId       String
  clientId       String?
  userId         String
  cashRegisterId String?
  totalAmount    Decimal  @db.Decimal(12, 2)
  paymentMethod  String
  channel        String   @default("POS")
  status         String   @default("COMPLETED")
  offlineId      String?
  createdAt      DateTime @default(now())
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client?              @relation(fields: [clientId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])
  cashRegister CashRegister?        @relation(fields: [cashRegisterId], references: [id])
  items        SaleItem[]
  loyaltyTx    LoyaltyTransaction[]
  @@unique([tenantId, offlineId])
  @@index([tenantId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@map("sale_items")
}

model CashRegister {
  id             String             @id @default(uuid())
  tenantId       String
  userId         String
  status         CashRegisterStatus @default(OPEN)
  openingFloat   Decimal            @db.Decimal(12, 2)
  openedAt       DateTime           @default(now())
  closedAt       DateTime?
  countedCash    Decimal?           @db.Decimal(12, 2)
  countedDebit   Decimal?           @db.Decimal(12, 2)
  countedCredit  Decimal?           @db.Decimal(12, 2)
  countedPix     Decimal?           @db.Decimal(12, 2)
  expectedTotal  Decimal?           @db.Decimal(12, 2)
  difference     Decimal?           @db.Decimal(12, 2)
  blindCountDone Boolean            @default(false)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])
  sales  Sale[]
  @@index([tenantId, status])
  @@map("cash_registers")
}

model WorkOrder {
  id                     String          @id @default(uuid())
  tenantId               String
  clientId               String
  assignedTechnicianId   String?
  status                 WorkOrderStatus @default(RECEIVED)
  deviceDescription      String
  imeiOrSerial           String?
  quoteAmount            Decimal?        @db.Decimal(12, 2)
  quoteValidUntil        DateTime?
  laborAmount            Decimal?        @db.Decimal(12, 2)
  approvalTokenHash      String?
  approvalTokenExpiresAt DateTime?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  tenant             Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client             Client @relation(fields: [clientId], references: [id])
  assignedTechnician User?  @relation("AssignedTechnician", fields: [assignedTechnicianId], references: [id])
  @@index([tenantId, status])
  @@map("work_orders")
}

model StockMovement {
  id        String            @id @default(uuid())
  tenantId  String
  productId String
  type      StockMovementType
  quantity  Decimal           @db.Decimal(12, 3)
  reason    String?
  saleId    String?
  createdAt DateTime          @default(now())
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  @@index([tenantId, productId, createdAt])
  @@map("stock_movements")
}

model LoyaltyProgram {
  id                      String   @id @default(uuid())
  tenantId                String   @unique
  active                  Boolean  @default(false)
  pointsPerCurrencyUnit   Decimal  @default(1) @db.Decimal(6, 2)
  redemptionValuePerPoint Decimal  @default(0.01) @db.Decimal(6, 4)
  minPointsToRedeem       Int      @default(100)
  pointsExpireAfterDays   Int?
  updatedAt               DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("loyalty_programs")
}

model LoyaltyAccount {
  id            String   @id @default(uuid())
  tenantId      String
  clientId      String   @unique
  pointsBalance Int      @default(0)
  updatedAt     DateTime @updatedAt
  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  client       Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String                 @id @default(uuid())
  loyaltyAccountId String
  type             LoyaltyTransactionType
  points           Int
  saleId           String?
  expiresAt        DateTime?
  reason           String?
  createdAt        DateTime               @default(now())
  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  sale           Sale?          @relation(fields: [saleId], references: [id])
  @@index([loyaltyAccountId, createdAt])
  @@map("loyalty_transactions")
}

model PersonalAccount {
  id                String              @id @default(uuid())
  tenantId          String
  name              String
  type              PersonalAccountType
  currentBalance    Decimal             @default(0) @db.Decimal(14, 2)
  creditLimit       Decimal?            @db.Decimal(14, 2)
  invoiceClosingDay Int?
  invoiceDueDay     Int?
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[]
  @@index([tenantId])
  @@map("personal_accounts")
}

model PersonalCategory {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  parentCategoryId  String?
  isCarneLeaoIncome Boolean  @default(false)
  createdAt         DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("personal_categories")
}

model PersonalTransaction {
  id                    String                  @id @default(uuid())
  tenantId              String
  accountId             String
  categoryId            String?
  createdByUserId       String
  type                  PersonalTransactionType
  amount                Decimal                 @db.Decimal(14, 2)
  transactionDate       DateTime
  description           String
  isPrivate             Boolean                 @default(false)
  openFinanceExternalId String?                 @unique
  createdAt             DateTime                @default(now())
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  @@index([tenantId, transactionDate])
  @@map("personal_transactions")
}

model PersonalDebt {
  id                  String   @id @default(uuid())
  tenantId            String
  name                String
  remainingAmount     Decimal  @db.Decimal(14, 2)
  interestRateMonthly Decimal  @db.Decimal(6, 4)
  minimumInstallment  Decimal  @db.Decimal(14, 2)
  status              String   @default("ACTIVE")
  createdAt           DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("personal_debts")
}

model PersonalBudget {
  id             String   @id @default(uuid())
  tenantId       String
  categoryId     String
  monthReference DateTime
  limitAmount    Decimal  @db.Decimal(14, 2)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, categoryId, monthReference])
  @@map("personal_budgets")
}

model PersonalBill {
  id                 String   @id @default(uuid())
  tenantId           String
  name               String
  amount             Decimal  @db.Decimal(14, 2)
  dueDay             Int
  reminderDaysBefore Int      @default(3)
  status             String   @default("PENDING")
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId, status])
  @@map("personal_bills")
}

model OpenFinanceConsent {
  id           String    @id @default(uuid())
  tenantId     String
  itemId       String    @unique
  status       String    @default("UPDATED")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@index([tenantId])
  @@map("open_finance_consents")
}

model NetWorthSnapshot {
  id               String   @id @default(uuid())
  tenantId         String
  snapshotDate     DateTime
  totalAssets      Decimal  @db.Decimal(14, 2)
  totalLiabilities Decimal  @db.Decimal(14, 2)
  netWorth         Decimal  @db.Decimal(14, 2)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@unique([tenantId, snapshotDate])
  @@map("net_worth_snapshots")
}

model AccountingFirmProfile {
  id                       String   @id @default(uuid())
  tenantId                 String   @unique
  displayName              String
  servicesOffered          String[]
  isListedInMarketplace    Boolean  @default(false)
  marketplaceRatingAverage Float    @default(0)
  marketplaceRatingCount   Int      @default(0)
  createdAt                DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  @@map("accounting_firm_profiles")
}

model AccountingEngagement {
  id                     String                     @id @default(uuid())
  accountingFirmTenantId String
  clientTenantId         String
  status                 AccountingEngagementStatus @default(PENDING_ACCOUNTANT_ACCEPTANCE)
  scopes                 String[]
  acceptanceDeadlineAt   DateTime
  acceptedAt             DateTime?
  acceptedByUserId       String?
  revokedAt              DateTime?
  revokedByUserId        String?
  revokedReason          String?
  createdAt              DateTime                   @default(now())
  accountingFirmTenant Tenant           @relation("EngagementsAsFirm", fields: [accountingFirmTenantId], references: [id])
  clientTenant         Tenant           @relation("EngagementsAsClient", fields: [clientTenantId], references: [id])
  tasks                AccountingTask[]
  @@index([accountingFirmTenantId, status])
  @@index([clientTenantId, status])
  @@map("accounting_engagements")
}

model AccountingTask {
  id           String    @id @default(uuid())
  tenantId     String
  engagementId String?
  code         String
  competence   String
  status       String    @default("PENDING")
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  tenant     Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagement AccountingEngagement? @relation(fields: [engagementId], references: [id])
  @@index([tenantId, status])
  @@map("accounting_tasks")
}
