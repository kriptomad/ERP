generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics", "tracing"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum TenantType {
  BUSINESS
  PERSONAL
  ACCOUNTING_OFFICE
}

enum TaxRegime {
  MEI
  SIMPLES_NACIONAL
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum PlanAudience {
  BUSINESS
  PERSONAL
  BOTH
}

enum AccountingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AccountingEngagementStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
  COMPLETED
}

enum UserRole {
  OWNER
  MANAGER
  TECHNICIAN
  CASHIER
  ACCOUNTANT
  HOUSEHOLD_MEMBER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  STORE_CREDIT
  BOLETO
}

enum SaleStatus {
  COMPLETED
  PENDING
  CANCELLED
  REFUNDED
}

enum SaleChannel {
  POS
  ONLINE
  WHATSAPP
  DELIVERY
}

enum StockMovementType {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
  PRODUCTION
  TRANSFER
  LOSS
}

enum AdjustmentSubtype {
  LOSS
  THEFT
  EXPIRATION
  REGISTRATION_ERROR
  INVENTORY_DIVERGENCE
}

enum WorkOrderStatus {
  RECEIVED
  DIAGNOSING
  AWAITING_APPROVAL
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  MANUAL_ADJUST
}

enum ProductTrackingType {
  NONE
  BATCH
  SERIAL
  VARIANT
}

enum FiscalDocumentType {
  NFC_E
  NFE
  NFCE
  CTE
  MDFE
}

enum FiscalDocumentStatus {
  PENDING
  AUTHORIZED
  CANCELLED
  DENIED
  CONTINGENCY
  SUBSTITUTED
}

enum FiscalEventType {
  AUTHORIZATION
  CANCELLATION
  CC_E
  MANIFESTATION
  CORRECTION_LETTER
  DENIAL
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  WHATSAPP
  SMS
}

enum NotificationCategory {
  SALE
  WORK_ORDER
  BILLING
  INVENTORY
  FINANCIAL
  REFERRAL
  BUDGET
  BILL
  SYSTEM
}

enum ReportFormat {
  PDF
  CSV
  XLSX
  JSON
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CREDIT_CARD
  CASH
}

enum BudgetStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InvestmentType {
  FIXED_INCOME
  VARIABLE_INCOME
  CRYPTO
  REAL_ESTATE
  OVERSEAS
}

enum DebtType {
  LOAN
  FINANCING
  CREDIT_CARD
  OTHER
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────
// LEGAL DOCUMENTS
// ─────────────────────────────────────────────────────────────────────────

model LegalDocumentVersion {
  id          String   @id @default(uuid())
  type        String   // "TERMS_OF_USE" | "PRIVACY_POLICY" | "SUBPROCESSORS"
  version     String   // ex.: "2025-01-v3"
  title       String
  content     String   @db.Text
  effectiveAt DateTime
  createdAt   DateTime @default(now())

  @@unique([type, version])
  @@map("legal_document_versions")
}

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM ADMIN (Painel do Dono)
// ─────────────────────────────────────────────────────────────────────────

model PlatformAdminUser {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                String    @default("SUPER_ADMIN")
  active              Boolean   @default(true)
  totpSecretEncrypted String?
  totpConfirmedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  impersonationLogs   ImpersonationLog[]

  @@map("platform_admin_users")
}

model ImpersonationLog {
  id              String   @id @default(uuid())
  platformAdminId String
  tenantId        String
  tenantName      String
  reason          String
  ip              String
  createdAt       DateTime @default(now())

  platformAdmin   PlatformAdminUser @relation(fields: [platformAdminId], references: [id])

  @@map("impersonation_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// FEATURE FLAGS & SYSTEM PARAMETERS
// ─────────────────────────────────────────────────────────────────────────

model SystemParameter {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_parameters")
}

model FeatureFlag {
  id             String    @id @default(uuid())
  key            String    @unique
  name           String
  description    String?
  enabled        Boolean   @default(false)
  rolloutPercent Int       @default(0)
  targetTenants  String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("feature_flags")
}

model IncidentEvent {
  id          String    @id @default(uuid())
  severity    String
  title       String
  description String?
  service     String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([severity, createdAt])
  @@map("incident_events")
}

model ReleaseNote {
  id          String   @id @default(uuid())
  version     String
  title       String
  description String
  publishedAt DateTime @default(now())

  @@map("release_notes")
}

// ─────────────────────────────────────────────────────────────────────────
// TENANCY, PLANS & BILLING
// ─────────────────────────────────────────────────────────────────────────

model Tenant {
  id                String       @id @default(uuid())
  parentTenantId    String?
  slug              String       @unique
  legalName         String
  tradeName         String
  cnpj              String?      @unique
  externalCustomerId String?     @unique
  tenantType        TenantType   @default(BUSINESS)
  status            TenantStatus @default(TRIAL)
  gracePeriodEndsAt DateTime?
  taxRegime         TaxRegime    @default(SIMPLES_NACIONAL)
  simplesNacionalAnexo String?
  inscricaoEstadual String?
  uf                String?
  termsAcceptedAt   DateTime?
  termsVersionAccepted String?
  privacyPolicyAcceptedAt DateTime?
  privacyPolicyVersionAccepted String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  parentTenant      Tenant?       @relation("TenantHierarchy", fields: [parentTenantId], references: [id])
  childTenants       Tenant[]      @relation("TenantHierarchy")
  subscriptions     Subscription[]
  tenantModules     TenantModule[]
  users             User[]
  clients           Client[]
  suppliers         Supplier[]
  products          Product[]
  productBatches    ProductBatch[]
  productSerials    ProductSerial[]
  productVariants   ProductVariant[]
  productVariantAxes ProductVariantAxis[]
  recipes           Recipe[]
  productionBatches ProductionBatch[]
  workOrders        WorkOrder[]
  sales             Sale[]
  cashRegisters     CashRegister[]
  cashRegisterMovements CashRegisterMovement[]
  stockMovements    StockMovement[]
  fiscalDocuments   FiscalDocument[]
  fiscalDocumentEvents FiscalDocumentEvent[]
  accountsPayable   AccountPayable[]
  accountsReceivable AccountReceivable[]
  returnableLedgerEntries ReturnableContainerLedger[]
  prescriptionRecords PrescriptionRecord[]
  taxRules          TaxRule[]
  ibsCbsRegimeElections TenantIbsCbsRegimeElection[]
  chartOfAccounts   ChartOfAccount[]
  costCenters       CostCenter[]
  bankAccounts      BankAccount[]
  purchaseOrders    PurchaseOrder[]
  inventoryCounts   InventoryCount[]
  inventoryCountItems InventoryCountItem[]
  osPhotos          OsPhoto[]
  dataImportJobs    DataImportJob[]
  imports           Import[]
  importStatusHistory ImportStatusHistory[]
  referralCode      ReferralCode?
  referredAs        Referral?     @relation("ReferredTenant")
  loyaltyProgram    LoyaltyProgram?
  loyaltyAccounts   LoyaltyAccount[]
  reportDefinitions ReportDefinition[]
  scheduledReports  ScheduledReport[]
  dashboardLayouts  DashboardLayout[]
  notifications     Notification[]
  notificationPreferences NotificationPreference[]
  pushDeviceTokens  PushDeviceToken[]

  // Filitech Pessoal (B2C)
  personalAccounts     PersonalAccount[]
  personalCategories   PersonalCategory[]
  personalTransactions PersonalTransaction[]
  personalBudgets      PersonalBudget[]
  personalGoals        PersonalGoal[]
  personalInvestments  PersonalInvestment[]
  personalDebts        PersonalDebt[]
  personalBills        PersonalBill[]
  netWorthSnapshots    NetWorthSnapshot[]
  openFinanceConsents  OpenFinanceConsent[]

  // Escritório de Contabilidade
  accountingFirmProfile       AccountingFirmProfile?
  engagementsAsFirm           AccountingEngagement[]   @relation("EngagementsAsFirm")
  engagementsAsClient         AccountingEngagement[]   @relation("EngagementsAsClient")
  accountingTasksAsFirm       AccountingTask[]         @relation("AccountingTasksAsFirm")
  accountingTasksAsClient     AccountingTask[]         @relation("AccountingTasksAsClient")
  officialTaxDocuments        OfficialTaxDocument[]    @relation("OfficialTaxDocumentsOfTenant")
  officialTaxDocumentsIssued  OfficialTaxDocument[]    @relation("OfficialTaxDocumentsGeneratedByFirm")
  companyPartners             CompanyPartner[]
  partnerPayouts              PartnerPayout[]
  appointments                Appointment[]
  accountingEngagements       AccountingEngagement[]   @relation("AccountingEngagementsAsClient")
  accountingTasks             AccountingTask[]         @relation("AccountingTasksRelation")
  billingEvents               BillingEvent[]

  @@index([status])
  @@index([parentTenantId])
  @@map("tenants")
}

model Plan {
  id              String       @id @default(uuid())
  code            String       @unique
  label           String
  basePrice       Decimal      @db.Decimal(10, 2)
  includedModules String[]
  active          Boolean      @default(true)
  audience        PlanAudience @default(BUSINESS)
  maxConnectedAccounts Int?

  subscriptions   Subscription[]

  @@map("plans")
}

model Module {
  id           String   @id @default(uuid())
  code         String   @unique
  label        String
  monthlyPrice Decimal  @db.Decimal(10, 2)
  description  String
  active       Boolean  @default(true)

  tenantModules TenantModule[]

  @@map("modules")
}

model TenantModule {
  id            String    @id @default(uuid())
  tenantId      String
  moduleCode    String
  active        Boolean   @default(true)
  activatedAt   DateTime  @default(now())
  deactivatedAt DateTime?

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module        Module    @relation(fields: [moduleCode], references: [code])

  @@unique([tenantId, moduleCode])
  @@index([tenantId, active])
  @@map("tenant_modules")
}

model Subscription {
  id                     String             @id @default(uuid())
  tenantId               String
  planId                 String?
  provider               String
  externalSubscriptionId String             @unique
  status                 SubscriptionStatus @default(TRIAL)
  pastDueSince           DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  paymentMethodToken     String?
  paymentMethodBrand     String?
  paymentMethodLast4     String?
  failedPaymentAttempts  Int                @default(0)
  nextRetryAt            DateTime?
  firstChargedAt         DateTime?
  cancelRequestedAt      DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)
  creditBalanceMonths    Int                @default(0)
  firstCycleDiscountPercent Int?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  tenant                 Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan                   Plan?              @relation(fields: [planId], references: [id])
  billingEvents          BillingEvent[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model BillingEvent {
  id               String       @id @default(uuid())
  subscriptionId   String?
  tenantId         String?
  provider         String
  externalEventKey String
  type             String
  payload          Json?
  createdAt        DateTime     @default(now())

  subscription     Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant           Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([provider, externalEventKey])
  @@index([subscriptionId, createdAt])
  @@map("billing_events")
}

// ─────────────────────────────────────────────────────────────────────────
// IDENTITY & RBAC
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  tenantId            String
  name                String
  email               String
  passwordHash        String
  role                UserRole
  active              Boolean   @default(true)
  preferredThemeMode  String    @default("light")
  totpSecretEncrypted String?
  totpConfirmedAt     DateTime?
  managerPinHash      String?
  termsVersionAccepted String?
  termsAcceptedAt     DateTime?
  privacyPolicyVersionAccepted String?
  privacyPolicyAcceptedAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions     RolePermission[]
  backupCodes         TwoFactorBackupCode[]
  passwordResetTokens PasswordResetToken[]
  activeSessions      ActiveSession[]
  salesRefundRequested Sale[]    @relation("SaleRefundRequestedBy")
  salesRefundAuthorized Sale[]   @relation("SaleRefundAuthorizedBy")
  sales               Sale[]
  workOrders          WorkOrder[] @relation("AssignedTechnician")
  cashRegistersOpened CashRegister[] @relation("CashRegisterOpenedBy")
  cashRegistersClosed CashRegister[] @relation("CashRegisterClosedBy")
  osPhotos            OsPhoto[]
  appointmentsAsProfessional Appointment[] @relation("AppointmentProfessional")
  reportDefinitionsCreated ReportDefinition[]
  dashboardLayout     DashboardLayout?
  purchaseOrdersCreated PurchaseOrder[]
  inventoryCountsStarted InventoryCount[] @relation("InventoryCountStartedBy")
  inventoryCountsApproved InventoryCount[] @relation("InventoryCountApprovedBy")
  inventoryCountItemsCounted InventoryCountItem[]
  dataImportJobsCreated DataImportJob[]
  importsCreated Import[]
  cashRegisterMovements CashRegisterMovement[]
  personalAccountsOwned PersonalAccount[] @relation("PersonalAccountOwner")
  personalTransactionsCreated PersonalTransaction[] @relation("PersonalTransactionCreatedBy")
  notifications       Notification[]                @relation("NotificationRecipient")
  notificationPreferences NotificationPreference[]  @relation("NotificationPreferenceUser")
  pushDeviceTokens    PushDeviceToken[]             @relation("PushDeviceTokenUser")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

model RoleDefaultPermission {
  id             String   @id @default(uuid())
  role           UserRole
  permissionCode String

  @@unique([role, permissionCode])
  @@map("role_default_permissions")
}

model RolePermission {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  permission String
  granted    Boolean  @default(true)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([tenantId, userId])
  @@map("role_permissions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model ActiveSession {
  id        String    @id @default(uuid())
  userId    String
  token     String
  ip        String?
  userAgent String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("active_sessions")
}

model TwoFactorBackupCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("two_factor_backup_codes")
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String?
  userId    String?
  action    String
  resource  String
  resourceId String?
  changes   Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// PARTIES
// ─────────────────────────────────────────────────────────────────────────

model Client {
  id                String   @id @default(uuid())
  tenantId          String
  name              String
  document          String?
  phone             String?
  email             String?
  creditLimit       Decimal  @default(0) @db.Decimal(12, 2)
  creditBalanceUsed Decimal  @default(0) @db.Decimal(12, 2)
  whatsappOptInAt   DateTime?
  whatsappOptOutAt  DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales             Sale[]
  workOrders        WorkOrder[]
  containerLedgerEntries ReturnableContainerLedger[]
  accountsReceivable AccountReceivable[]
  loyaltyAccount    LoyaltyAccount?

  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("clients")
}

model Supplier {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products  Product[]
  preferredByProducts Product[] @relation("PreferredSupplier")
  purchaseOrders PurchaseOrder[]
  imports   Import[]
  accountsPayable AccountPayable[]

  @@unique([tenantId, document])
  @@map("suppliers")
}

// ─────────────────────────────────────────────────────────────────────────
// PRODUCT CATALOG
// ─────────────────────────────────────────────────────────────────────────

model Product {
  id                    String              @id @default(uuid())
  tenantId              String
  supplierId            String?
  preferredSupplierId   String?
  sku                   String
  barcode               String?
  name                  String
  description           String?
  category              String?
  trackingType          ProductTrackingType @default(NONE)
  ncm                   String?             @default("00000000")
  cest                  String?
  originUf              String?
  nicheCode             String?
  unitPrice             Decimal             @db.Decimal(12, 2)
  wholesalePrice        Decimal?            @db.Decimal(12, 2)
  resalePrice           Decimal?            @db.Decimal(12, 2)
  wholesaleMinQty       Int?
  stockQuantity         Decimal             @default(0) @db.Decimal(12, 3)
  minStockThreshold     Decimal?            @db.Decimal(12, 3)
  costPrice             Decimal?            @db.Decimal(12, 4)
  reorderTargetQuantity Decimal?            @db.Decimal(12, 3)
  isWeighted            Boolean             @default(false)
  isReturnableContainer Boolean             @default(false)
  isReturnable          Boolean             @default(true)
  requiresPrescriptionRetention Boolean     @default(false)
  isControlledSubstance Boolean             @default(false)
  active                Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier              Supplier?           @relation(fields: [supplierId], references: [id])
  preferredSupplier     Supplier?           @relation("PreferredSupplier", fields: [preferredSupplierId], references: [id])
  batches               ProductBatch[]
  serials               ProductSerial[]
  variantAxes           ProductVariantAxis[]
  variants              ProductVariant[]
  recipe                Recipe?
  recipeUsages          RecipeItem[]        @relation("RecipeIngredient")
  saleItems             SaleItem[]
  workOrderItems        WorkOrderItem[]
  stockMovements        StockMovement[]
  productionBatchOutputs ProductionBatch[]  @relation("ProductionOutput")
  purchaseOrderItems    PurchaseOrderItem[]
  inventoryCountItems   InventoryCountItem[]
  returnableLedgerEntries ReturnableContainerLedger[]
  prescriptionRecords   PrescriptionRecord[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId, category])
  @@index([tenantId, active])
  @@map("products")
}

model ProductBatch {
  id                String   @id @default(uuid())
  tenantId          String
  productId         String
  batchNumber       String
  manufacturingDate DateTime?
  expirationDate    DateTime
  quantity          Decimal  @db.Decimal(12, 3)
  costPrice         Decimal? @db.Decimal(12, 4)
  receivedAt        DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]
  saleItems         SaleItem[]

  @@unique([tenantId, productId, batchNumber])
  @@index([tenantId, productId, expirationDate])
  @@map("product_batches")
}

model ProductSerial {
  id           String     @id @default(uuid())
  tenantId     String
  productId    String
  serialNumber String
  imei         String?
  status       String     @default("IN_STOCK")
  createdAt    DateTime   @default(now())

  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serialNumber])
  @@index([tenantId, imei])
  @@map("product_serials")
}

model ProductVariantAxis {
  id        String   @id @default(uuid())
  tenantId  String
  productId String
  name      String
  values    String[]

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId, name])
  @@map("product_variant_axes")
}

model ProductVariant {
  id            String   @id @default(uuid())
  tenantId      String
  productId     String
  sku           String
  barcode       String?
  name          String
  attributes    Json
  unitPrice     Decimal  @db.Decimal(12, 2)
  stockQuantity Decimal  @default(0) @db.Decimal(12, 3)
  active        Boolean  @default(true)

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku])
  @@map("product_variants")
}

model PrescriptionRecord {
  id                String   @id @default(uuid())
  tenantId          String
  saleId            String
  productId         String
  type              String
  retentionImageUrl  String?
  electronicKey     String?
  prescriptionNumber String?
  pharmacistName    String?
  pharmacistCrf     String?
  createdAt         DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id])

  @@unique([tenantId, saleId, productId])
  @@map("prescription_records")
}

// ─────────────────────────────────────────────────────────────────────────
// RECIPES & PRODUCTION (Padaria)
// ─────────────────────────────────────────────────────────────────────────

model Recipe {
  id              String   @id @default(uuid())
  tenantId        String
  productId       String   @unique
  name            String
  yieldQuantity   Decimal  @db.Decimal(12, 3)
  preparationTime Int?
  instructions    String?  @db.Text
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  items           RecipeItem[]
  productionBatches ProductionBatch[]

  @@map("recipes")
}

model RecipeItem {
  id            String   @id @default(uuid())
  recipeId      String
  ingredientId  String
  quantity      Decimal  @db.Decimal(12, 3)
  unit          String
  unitCost      Decimal? @db.Decimal(12, 4)

  recipe        Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Product  @relation("RecipeIngredient", fields: [ingredientId], references: [id])

  @@index([recipeId])
