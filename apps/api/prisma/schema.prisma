  salesRefundRequestedBy User?   @relation("SaleRefundRequestedBy", fields: [refundRequestedBy], references: [id])
  salesRefundAuthorizedBy User?   @relation("SaleRefundAuthorizedBy", fields: [refundAuthorizedBy], references: [id])

