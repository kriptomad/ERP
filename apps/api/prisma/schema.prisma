  createdAt DateTime @default(now())

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[] @relation("TransactionCategory")
  budgets   PersonalBudget[]          @relation("BudgetCategory")
  defaultAccounts PersonalAccount[]   @relation("AccountDefaultCategory")

  @@unique([tenantId, name, type])
  @@map("personal_categories")
}

model PersonalTransaction {
  id                String           @id @default(uuid())
  tenantId          String
  accountId         String
  categoryId        String?
  createdBy         String
  type              TransactionType
  amount            Decimal          @db.Decimal(12, 2)
  description       String
  transactionDate   DateTime
  notes             String?
  isPrivate         Boolean          @default(false)
  attachments       String[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account           PersonalAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdByUser     User             @relation("PersonalTransactionCreatedBy", fields: [createdBy], references: [id])
  category          PersonalCategory? @relation("TransactionCategory", fields: [categoryId], references: [id])
  splits            PersonalTransactionSplit[]

  @@index([tenantId, accountId, transactionDate])
  @@map("personal_transactions")
}

model PersonalTransactionSplit {
  id                String   @id @default(uuid())
  transactionId     String
  memberName        String
  amount            Decimal  @db.Decimal(12, 2)

  transaction       PersonalTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("personal_transaction_splits")
}

model PersonalBudget {
  id            String       @id @default(uuid())
  tenantId      String
  categoryId    String?
  name          String
  limitAmount   Decimal      @db.Decimal(12, 2)
  month         Int
  year          Int
  status        BudgetStatus @default(ACTIVE)
  alertSent80   Boolean      @default(false)
  alertSent100  Boolean      @default(false)
  createdAt     DateTime     @default(now())

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category      PersonalCategory? @relation("BudgetCategory", fields: [categoryId], references: [id])

  @@unique([tenantId, categoryId, month, year])
  @@map("personal_budgets")
}

model PersonalGoal {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  targetAmount  Decimal     @db.Decimal(12, 2)
  currentAmount Decimal     @default(0) @db.Decimal(12, 2)
  targetDate    DateTime?
  status        GoalStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("personal_goals")
}

model PersonalInvestment {
  id            String         @id @default(uuid())
  tenantId      String
  name          String
  type          InvestmentType
  ticker        String?
  institution   String?
  quantity      Decimal?       @db.Decimal(12, 4)
  averagePrice  Decimal?      @db.Decimal(12, 4)
  currentPrice  Decimal?      @db.Decimal(12, 4)
  totalValue    Decimal?      @db.Decimal(12, 2)
  pluggyItemId  String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("personal_investments")
}

model PersonalDebt {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  type          DebtType
  totalAmount   Decimal   @db.Decimal(12, 2)
  remainingAmount Decimal  @db.Decimal(12, 2)
  interestRate  Decimal?  @db.Decimal(6, 4)
  monthlyPayment Decimal? @db.Decimal(12, 2)
  dueDate       DateTime?
  pluggyItemId  String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("personal_debts")
}

model PersonalBill {
  id            String      @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  amount        Decimal     @db.Decimal(12, 2)
  dueDate       DateTime
  status        String      @default("PENDING")
  recurrence    String?
  alertSent     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, dueDate])
  @@map("personal_bills")
}

model NetWorthSnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  snapshotDate  DateTime @default(now())
  totalAssets   Decimal  @db.Decimal(12, 2)
  totalDebts    Decimal  @db.Decimal(12, 2)
  netWorth      Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, snapshotDate])
  @@map("net_worth_snapshots")
}

model OpenFinanceConsent {
  id              String    @id @default(uuid())
  tenantId        String
  provider        String
  consentId       String
  status          String
  accountsSynced  Int       @default(0)
  lastSyncAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("open_finance_consents")
}

// ─────────────────────────────────────────────────────────────────────────
// ACCOUNTING OFFICE
// ─────────────────────────────────────────────────────────────────────────

model AccountingFirmProfile {
  id                String   @id @default(uuid())
  tenantId          String   @unique
  cnpj              String?
  razaoSocial       String?
  inscricaoMunicipal String?
  contadorName      String?
  contadorCrc       String?
  specializations   String[]
  services          String[] @default([])
  isListedInMarketplace Boolean @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  engagementsAsFirm AccountingEngagement[] @relation("FirmProfileEngagements")
  reviews           AccountingMarketplaceReview[]

  @@map("accounting_firm_profiles")
}

model AccountingEngagement {
  id                String   @id @default(uuid())
  tenantId          String
  firmTenantId      String?
  clientTenantId    String?
  firmProfileId     String?
  status            String   @default("ACTIVE")
  scopes            String[] @default([])
  acceptedAt        DateTime?
  expiresAt         DateTime?
  startDate         DateTime @default(now())
  endDate           DateTime?
  monthlyFee        Decimal? @db.Decimal(12, 2)
  createdAt         DateTime @default(now())

  tenant            Tenant   @relation("AccountingEngagementsAsClient", fields: [tenantId], references: [id], onDelete: Cascade)
  firm              Tenant?  @relation("EngagementsAsFirm", fields: [firmTenantId], references: [id])
  client            Tenant?  @relation("EngagementsAsClient", fields: [clientTenantId], references: [id])
  firmProfile       AccountingFirmProfile? @relation("FirmProfileEngagements", fields: [firmProfileId], references: [id])
  auditEvents       AccountingEngagementAuditEvent[]

  @@index([tenantId, status])
  @@map("accounting_engagements")
}

model AccountingEngagementAuditEvent {
  id            String   @id @default(uuid())
  engagementId  String
  event         String
  actorTenantId String?
  metadata      Json?
  createdAt     DateTime @default(now())

  engagement    AccountingEngagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@index([engagementId, createdAt])
  @@map("accounting_engagement_audit_events")
}

model AccountingMarketplaceReview {
  id             String   @id @default(uuid())
  firmProfileId  String
  clientTenantId String
  engagementId   String?
  rating         Int
  comment        String?
  createdAt      DateTime @default(now())

  firmProfile    AccountingFirmProfile @relation(fields: [firmProfileId], references: [id], onDelete: Cascade)

  @@index([firmProfileId, createdAt])
  @@map("accounting_marketplace_reviews")
}

model AccountingTask {
  id              String   @id @default(uuid())
  tenantId        String
  firmTenantId    String?
  clientTenantId  String?
  title           String
  description     String?
  status          String   @default("PENDING")
  dueDate         DateTime?
  completedAt     DateTime?
  documentType    String?
  recurrence      String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation("AccountingTasksRelation", fields: [tenantId], references: [id], onDelete: Cascade)
  firm            Tenant?  @relation("AccountingTasksAsFirm", fields: [firmTenantId], references: [id])
  client          Tenant?  @relation("AccountingTasksAsClient", fields: [clientTenantId], references: [id])

  @@index([tenantId, status])
  @@map("accounting_tasks")
}

model OfficialTaxDocument {
  id              String   @id @default(uuid())
  tenantId        String
  firmTenantId    String?
  documentType    String
  referencePeriod String
  status          String
  filedAt         DateTime?
  createdAt       DateTime @default(now())

  tenantOfficial  Tenant?  @relation("OfficialTaxDocumentsOfTenant", fields: [tenantId], references: [id])
  generatedByFirm Tenant?  @relation("OfficialTaxDocumentsGeneratedByFirm", fields: [firmTenantId], references: [id])

  @@index([tenantId, documentType, referencePeriod])
  @@map("official_tax_documents")
}

model CompanyPartner {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  cpf           String?
  ownershipPercent Decimal @db.Decimal(5, 2)
  monthlySalary Decimal?  @db.Decimal(12, 2)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payouts       PartnerPayout[]

  @@index([tenantId])
  @@map("company_partners")
}

model PartnerPayout {
  id            String   @id @default(uuid())
  tenantId      String
  partnerId     String
  amount        Decimal  @db.Decimal(12, 2)
  period        String
  type          String
  status        String   @default("PENDING")
  paidAt        DateTime?
  createdAt     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  partner       CompanyPartner @relation(fields: [partnerId], references: [id])

  @@index([tenantId, partnerId, period])
  @@map("partner_payouts")
}

model Appointment {
  id              String   @id @default(uuid())
  tenantId        String
  professionalId  String
  clientId        String?
  serviceType     String
  scheduledAt     DateTime
  durationMinutes Int      @default(30)
  status          String   @default("SCHEDULED")
  notes           String?
  createdAt       DateTime @default(now())

  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  professional    User     @relation("AppointmentProfessional", fields: [professionalId], references: [id])

  @@index([tenantId, professionalId, scheduledAt])
  @@map("appointments")
}

