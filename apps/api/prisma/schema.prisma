// HELPDESK & API MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────

model HelpdeskTicket {
  id          String    @id @default(uuid())
  tenantId    String?
  tenantName  String?
  userId      String?
  userName    String?
  category    String
  subject     String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  assignedTo  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority])
  @@map("helpdesk_tickets")
}

model IntegrationCredential {
  id              String    @id @default(uuid())
  provider        String
  credentialType  String
  encryptedValue  String
  environment     String    @default("production")
  active          Boolean   @default(true)
  lastHealthCheckAt DateTime?
  healthStatus    String    @default("UNKNOWN")
  healthDetails   Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([provider, environment])
  @@map("integration_credentials")
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@map("api_keys")
}

model TenantWebhook {
  id            String    @id @default(uuid())
  tenantId      String
  url           String
  events        String[]
  secret        String
  active        Boolean   @default(true)
  lastTriggerAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, active])
  @@map("tenant_webhooks")
}

model OfficialDocumentLayoutVersion {
  id            String   @id @default(uuid())
  documentType  String
  version       String
  layoutJson    Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  @@unique([documentType, version])
  @@map("official_document_layout_versions")
}

model FiscalCodeCatalog {
  id            String   @id @default(uuid())
  codeType      String
  code          String
  description   String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  @@unique([codeType, code])
  @@map("fiscal_code_catalog")
}

// -------------------------------------------------------------------
// IMPORTACAO ASSISTIDA 4 PASSOS (Cap. 17/18)
// -------------------------------------------------------------------

model Import {
  id            String               @id @default(uuid())
  tenantId      String
  supplierId    String
  supplierName  String
  status        String               @default("STEP_1_RECEBIDO")
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier      Supplier             @relation(fields: [supplierId], references: [id])
  createdBy     User                 @relation(fields: [createdById], references: [id])
  items         ImportItem[]
  statusHistory ImportStatusHistory[]

  @@index([tenantId, status])
  @@map("imports")
}

model ImportItem {
  id              String   @id @default(uuid())
  importId        String
  productId       String
  sku             String
  name            String
  quantity        Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(12, 4)
  countryOfOrigin String?
  ncm             String
  cest            String?

  import          Import   @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("import_items")
}

model ImportStatusHistory {
  id        String   @id @default(uuid())
  importId  String
  tenantId  String
  status    String
  createdAt DateTime @default(now())

  import    Import   @relation(fields: [importId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([importId, createdAt])
  @@map("import_status_history")
}
