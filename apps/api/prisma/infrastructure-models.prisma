// Infrastructure and Platform Models — must be merged into schema.prisma
// These models were separated for clarity but need to be in the main schema file.

// ─────────────────────────────────────────────────────────────────────────
// PLATFORM ADMIN (Painel do Dono)
// ─────────────────────────────────────────────────────────────────────────

model PlatformAdminUser {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                String    @default("SUPER_ADMIN") // SUPER_ADMIN | FINANCE_ANALYST | SUPPORT_AGENT
  active              Boolean   @default(true)
  totpSecretEncrypted String?
  totpConfirmedAt     DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("platform_admin_users")
}

model ImpersonationLog {
  id              String   @id @default(uuid())
  platformAdminId String
  tenantId        String
  tenantName      String
  reason          String
  ip              String
  createdAt       DateTime @default(now())

  @@map("impersonation_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// FEATURE FLAGS & SYSTEM PARAMETERS
// ─────────────────────────────────────────────────────────────────────────

model SystemParameter {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_parameters")
}

model FeatureFlag {
  id             String    @id @default(uuid())
  key            String    @unique
  name           String
  description    String?
  enabled        Boolean   @default(false)
  rolloutPercent Int       @default(0)
  targetTenants  String[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("feature_flags")
}

model IncidentEvent {
  id          String    @id @default(uuid())
  severity    String
  title       String
  description String?
  service     String?
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([severity, createdAt])
  @@map("incident_events")
}

model ReleaseNote {
  id          String   @id @default(uuid())
  version     String
  title       String
  description String
  publishedAt DateTime @default(now())

  @@map("release_notes")
}

// ─────────────────────────────────────────────────────────────────────────
// LEGAL DOCUMENTS
// ─────────────────────────────────────────────────────────────────────────

model LegalDocumentVersion {
  id          String   @id @default(uuid())
  type        String   // "TERMS_OF_USE" | "PRIVACY_POLICY" | "SUBPROCESSORS"
  version     String   // ex.: "2025-01-v3"
  title       String
  content     String   @db.Text
  effectiveAt DateTime
  createdAt   DateTime @default(now())

  @@unique([type, version])
  @@map("legal_document_versions")
}

// ─────────────────────────────────────────────────────────────────────────
// HELPDESK & API MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────

model HelpdeskTicket {
  id          String    @id @default(uuid())
  tenantId    String?
  tenantName  String?
  userId      String?
  userName    String?
  category    String
  subject     String
  description String
  status      String    @default("OPEN")
  priority    String    @default("MEDIUM")
  assignedTo  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, priority])
  @@map("helpdesk_tickets")
}

model IntegrationCredential {
  id                String    @id @default(uuid())
  provider          String
  credentialType    String
  encryptedValue    String
  environment       String    @default("production")
  active            Boolean   @default(true)
  lastHealthCheckAt DateTime?
  healthStatus      String    @default("UNKNOWN")
  healthDetails     Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([provider, environment])
  @@map("integration_credentials")
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  keyHash     String    @unique
  keyPrefix   String
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@map("api_keys")
}

model TenantWebhook {
  id            String    @id @default(uuid())
  tenantId      String
  url           String
  events        String[]
  secret        String
  active        Boolean   @default(true)
  lastTriggerAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([tenantId, active])
  @@map("tenant_webhooks")
}

model OfficialDocumentLayoutVersion {
  id            String   @id @default(uuid())
  documentType  String
  version       String
  layoutJson    Json
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  @@unique([documentType, version])
  @@map("official_document_layout_versions")
}

model FiscalCodeCatalog {
  id            String   @id @default(uuid())
  codeType      String
  code          String
  description   String
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())

  @@unique([codeType, code])
  @@map("fiscal_code_catalog")
}
