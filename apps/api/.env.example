# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filitech_erp?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_PRIVATE_KEY_PATH="./keys/jwt-private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt-public.pem"
JWT_ISSUER="filitech-erp"
JWT_EXPIRES_IN="8h"

# Server
PORT=3000
NODE_ENV=development
API_URL="http://localhost:3000"
WEB_URL="http://localhost:3001"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="filitech-assets"

# Asaas (Billing)
ASAAS_API_KEY=""
ASAAS_API_URL="https://api.asaas.com/v3"

# Stripe (Billing - International)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Focus NFe (Fiscal)
FOCUS_NFE_API_KEY=""
FOCUS_NFE_API_URL="https://api.focusnfe.com.br"

# Sentry (Monitoring)
SENTRY_DSN=""

# Logging
LOG_LEVEL="info"
